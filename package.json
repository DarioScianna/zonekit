{
  "name": "zonekit",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript geometry for polygonal zones: validation, overlap detection and simplification.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build:demo": "tsc --project tsconfig.demo.json",
    "serve": "npm run build:demo && npx --yes serve docs"
  },
  "keywords": [
    "geometry",
    "polygon",
    "geofencing",
    "simplification",
    "visvalingam",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarioScianna/zonekit.git"
  },
  "homepage": "https://darioscianna.github.io/zonekit/",
  "author": "Dario Scianna"
}
